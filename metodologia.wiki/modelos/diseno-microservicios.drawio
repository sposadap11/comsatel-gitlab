        <mxCell id="j1Q4P6ECcRPmYqQHR8c3-158" value="&lt;span style=&quot;font-size: 11.0pt ; line-height: 107% ; font-family: &amp;#34;calibri&amp;#34; , sans-serif&quot;&gt;«layer»&lt;br&gt;&lt;/span&gt;Application" style="shape=folder;fontStyle=0;tabWidth=70;tabHeight=10;tabPosition=left;html=1;boundedLbl=1;fontSize=13;align=center;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1">
