        <mxCell id="wVuuXcATziIqGyWMA4P9-26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;" value="DELETE" vertex="1">
