        <mxCell id="wVuuXcATziIqGyWMA4P9-20" parent="1" style="whiteSpace=wrap;html=1;rounded=1;labelBackgroundColor=none;" value="Domain Services" vertex="1">
          <mxGeometry height="40" width="90" x="430" y="460" as="geometry" />
