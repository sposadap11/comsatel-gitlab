        </mxCell>
        <mxCell id="j1Q4P6ECcRPmYqQHR8c3-159" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0;entryDx=164.5;entryDy=45;entryPerimeter=0;fontSize=12;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="j1Q4P6ECcRPmYqQHR8c3-160" target="j1Q4P6ECcRPmYqQHR8c3-161">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="j1Q4P6ECcRPmYqQHR8c3-160" value="&lt;span style=&quot;font-size: 11.0pt ; line-height: 107% ; font-family: &amp;#34;calibri&amp;#34; , sans-serif&quot;&gt;«layer»&lt;br&gt;&lt;/span&gt;Infrastructure" style="shape=folder;fontStyle=0;tabWidth=70;tabHeight=10;tabPosition=left;html=1;boundedLbl=1;fontSize=13;align=center;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="3016.12" y="110" width="164.5" height="80" as="geometry" />
        </mxCell>
        <mxCell id="j1Q4P6ECcRPmYqQHR8c3-161" value="&lt;span style=&quot;font-size: 11.0pt ; line-height: 107% ; font-family: &amp;#34;calibri&amp;#34; , sans-serif&quot;&gt;«layer»&lt;br&gt;&lt;/span&gt;Domain" style="shape=folder;fontStyle=0;tabWidth=70;tabHeight=10;tabPosition=left;html=1;boundedLbl=1;fontSize=13;align=center;whiteSpace=wrap;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2896.12" y="240" width="164.5" height="80" as="geometry" />
        </mxCell>
        <mxCell id="j1Q4P6ECcRPmYqQHR8c3-162" value="&lt;h1 style=&quot;font-size: 14px&quot;&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Diagrama de Estados&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;El Diagrama de Estados de UML es el que se debe emplear para especificar como parte del Modelo Lógico (Estructura) ciertos comportamiento marcado por estados significativos del ciclo de vida de conceptos claves (forman parte de la Capa &quot;Domain&quot; de Domain Driven Design (DDD)&lt;/font&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=13;align=left;" vertex="1" parent="1">
          <mxGeometry x="2510" y="350" width="710" height="90" as="geometry" />
        </mxCell>
        <mxCell id="j1Q4P6ECcRPmYqQHR8c3-163" value="&lt;b&gt;Estado Inicial: &lt;/b&gt;Su propósito es delimitar el punto de inicio del ciclo de de vida de un objeto de interés (para elementos claves de la&amp;nbsp;Capa de Dominio)&lt;br&gt;&lt;br&gt;&lt;b&gt;Estado Final:&lt;/b&gt;&amp;nbsp;Su propósito es delimitar el punto de finalización de la vida de un objeto de interés (para elementos claves de la Capa de Dominio)&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;b&gt;Estado (intermedio)&lt;/b&gt;: Su propósito es definir los estados significativos de un concepto clave a través de su ciclo de vida.&lt;br&gt;&lt;br&gt;&lt;b&gt;Transición&lt;/b&gt;: Su propósito es definir las reglas que gobiernan las transiciones entre los estados significativos del objeto toda vez que ocurre un Evento de Negocio, se satisfacen ciertas restricciones o reglas de negocio y estas gatillan a su vez acciones. Este modelo de transición se ajusta a las Reglas ECA (Event - Constraint - Action)&lt;br&gt;&lt;br&gt;&lt;b&gt;Sincronización&lt;/b&gt;: Su propósito es establecer, cuando se requiere, de puntos en el flujo donde este puede desdoblarse o integrar varios lineas&amp;nbsp;&amp;nbsp;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2510" y="540" width="739" height="210" as="geometry" />
        </mxCell>
        <mxCell id="j1Q4P6ECcRPmYqQHR8c3-164" value="&amp;lt;Nombre del Estado&amp;gt;" style="html=1;align=center;verticalAlign=middle;rounded=1;absoluteArcSize=1;arcSize=19;dashed=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2726.5" y="450" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="j1Q4P6ECcRPmYqQHR8c3-165" value="Estado Final" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;fontSize=12;align=left;verticalAlign=middle;labelPosition=right;verticalLabelPosition=middle;" vertex="1" parent="1">
          <mxGeometry x="2936.5" y="465" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="j1Q4P6ECcRPmYqQHR8c3-166" value="Estado Inicial" style="ellipse;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=left;verticalAlign=middle;labelPosition=right;verticalLabelPosition=middle;" vertex="1" parent="1">
          <mxGeometry x="2596.5" y="465" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="j1Q4P6ECcRPmYqQHR8c3-167" value="transicion" style="endArrow=blockThin;html=1;rounded=0;fontSize=12;endFill=1;" edge="1" parent="1">
          <mxGeometry x="-3.5" y="-10" width="50" height="50" as="geometry">
            <mxPoint x="3066.5" y="479.28999999999996" as="sourcePoint" />
            <mxPoint x="3146.5" y="479.28999999999996" as="targetPoint" />
            <mxPoint x="1" y="-9" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="j1Q4P6ECcRPmYqQHR8c3-168" value="&lt;h1 style=&quot;font-size: 14px&quot;&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Diagrama Ejemplo&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;En el siguiente Diagrama de Estados se muestra una representación utilizando los elementos básicos de la Notación UML recomendada.&lt;/font&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=13;align=left;" vertex="1" parent="1">
          <mxGeometry x="2510" y="762" width="710" height="70" as="geometry" />
        </mxCell>
        <mxCell id="j1Q4P6ECcRPmYqQHR8c3-169" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;endArrow=blockThin;endFill=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="j1Q4P6ECcRPmYqQHR8c3-170" target="j1Q4P6ECcRPmYqQHR8c3-175">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2501" y="946" as="targetPoint" />
