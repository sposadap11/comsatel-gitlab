        <object placeholders="1" c4Name="Superset" c4Type="Container" c4Technology="Web" c4Description="Gestiona peticiones HTTP de la UI y API. Es stateless, escala horizontalmente y consulta la base de datos para autenticar usuarios y renderizar dashboards." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="rypsbyU1hXLpsf9HzSjX-1">
