        <mxCell id="UZltXh6Wh5-jFhGSdRaW-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;fillColor=#f5f5f5;strokeColor=#666666;gradientColor=#b3b3b3;" value="Evolve" vertex="1">
          <mxGeometry height="60" width="120" x="336" y="1466" as="geometry" />
        </mxCell>
        <mxCell id="UZltXh6Wh5-jFhGSdRaW-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;fillColor=#fff2cc;strokeColor=#d6b656;gradientColor=#ffd966;" value="Talk in ubiquitous language" vertex="1">
          <mxGeometry height="60" width="169" x="423" y="1256" as="geometry" />
        </mxCell>
        <mxCell id="UZltXh6Wh5-jFhGSdRaW-20" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;labelBackgroundColor=none;fontSize=12;align=center;size=0.04;spacingLeft=5;spacingRight=5;fillColor=#cdeb8b;strokeColor=#36393d;" value="...product development teams must focus on the core domain, that is, the parts that are most important to a business and which need more attention than others..." vertex="1">
          <mxGeometry height="90" width="250" x="82" y="1576" as="geometry" />
        </mxCell>
        <mxCell id="UZltXh6Wh5-jFhGSdRaW-21" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;labelBackgroundColor=none;fontSize=12;align=center;size=0.04;spacingLeft=5;spacingRight=5;fillColor=#fff2cc;strokeColor=#d6b656;gradientColor=#ffd966;" value="...The design team can establish deep understanding, and connect domain jargons and software entities with ubiquitous language to keep discovering and evolving their domain models...." vertex="1">
          <mxGeometry height="190" width="160" x="602" y="1576" as="geometry" />
        </mxCell>
        <mxCell id="UZltXh6Wh5-jFhGSdRaW-22" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;labelBackgroundColor=none;fontSize=12;align=center;size=0.04;spacingLeft=5;spacingRight=5;fillColor=#f8cecc;strokeColor=#b85450;gradientColor=#ea6b66;" value="...a domain model, which is well-organized and structured knowledge of the problem in the core domain space along with fundamental concepts, vocabulary, issues, and relationships among the involved entities..." vertex="1">
          <mxGeometry height="90" width="250" x="82" y="1676" as="geometry" />
        </mxCell>
        <mxCell id="UZltXh6Wh5-jFhGSdRaW-23" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;labelBackgroundColor=none;fontSize=12;align=center;size=0.04;spacingLeft=5;spacingRight=5;fillColor=#f5f5f5;strokeColor=#666666;gradientColor=#b3b3b3;" value="...Domain models need to evolve over time through iterations and feedback..." vertex="1">
          <mxGeometry height="90" width="250" x="341" y="1676" as="geometry" />
        </mxCell>
        <mxCell id="UZltXh6Wh5-jFhGSdRaW-24" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;labelBackgroundColor=none;fontSize=12;align=center;size=0.04;spacingLeft=5;spacingRight=5;fillColor=#dae8fc;strokeColor=#6c8ebf;gradientColor=#7ea6e0;" value="...software experts may not know the domain, and the domain analysts may not know the technology and software implementations..." vertex="1">
          <mxGeometry height="90" width="250" x="341" y="1576" as="geometry" />
        </mxCell>
        <mxCell id="UZltXh6Wh5-jFhGSdRaW-25" parent="1" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;shadow=1;glass=0;labelBackgroundColor=none;sketch=0;fontSize=12;align=center;spacingLeft=20;spacingRight=20;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Domain Model&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Organized and structured knowledge related to the specific problem." vertex="1">
          <mxGeometry height="152" width="209" x="548" y="1324" as="geometry" />
        </mxCell>
