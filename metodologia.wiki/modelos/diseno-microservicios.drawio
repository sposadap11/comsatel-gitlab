        <mxCell id="sfauP4_STNm2YwoQOB3Z-21" value="5.1 Transacción en BD" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Tahoma;fontSize=12;strokeWidth=1;exitX=1.17;exitY=0.867;exitDx=0;exitDy=0;exitPerimeter=0;align=left;" parent="1" source="sfauP4_STNm2YwoQOB3Z-8" target="sfauP4_STNm2YwoQOB3Z-19" edge="1">
