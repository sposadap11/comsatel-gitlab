        <mxCell id="sfauP4_STNm2YwoQOB3Z-40" value="4. Validar credenciales con&lt;br&gt;servicio IdM" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontFamily=Tahoma;fontSize=12;strokeWidth=1;align=left;" parent="sfauP4_STNm2YwoQOB3Z-39" edge="1">
