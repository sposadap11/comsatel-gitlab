        <mxCell id="wVuuXcATziIqGyWMA4P9-28" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.047222264607747394;" value="Se utiliza este verbo cuando deseamos crear una nueva instancia (recurso) para un determinado tipo de recurso (Objeto del Negocio)" vertex="1">
