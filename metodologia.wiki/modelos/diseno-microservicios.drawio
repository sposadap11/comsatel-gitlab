        <mxCell id="UZltXh6Wh5-jFhGSdRaW-160" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;labelBackgroundColor=none;fontSize=10;align=center;size=0.04;spacingLeft=5;spacingRight=5;fillColor=#fff2cc;strokeColor=#d6b656;gradientColor=#ffd966;" value="&lt;b&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;4&lt;/font&gt;&lt;/b&gt;&lt;br&gt;significa diseñar un software de tal forma que se encuentre &lt;b&gt;libre &lt;/b&gt;de cualquier restricción o limitación que &lt;b&gt;no sea natural&lt;/b&gt; en el &lt;b&gt;contexto del problema&lt;/b&gt;." vertex="1">
