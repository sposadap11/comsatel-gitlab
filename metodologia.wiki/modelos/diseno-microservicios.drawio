        <mxCell id="UZltXh6Wh5-jFhGSdRaW-146" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;fillColor=#fff2cc;strokeColor=#d6b656;gradientColor=#ffd966;" value="4.&lt;br&gt;Generalidad" vertex="1">
          <mxGeometry height="60" width="120" x="2098" y="1427" as="geometry" />
