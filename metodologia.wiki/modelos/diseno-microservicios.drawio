        <mxCell id="j1Q4P6ECcRPmYqQHR8c3-98" value="// Id del vehículo" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;endArrow=block;endFill=1;dashed=1;rounded=0;dashPattern=1 1;fontSize=12;entryX=1;entryY=0.863;entryDx=0;entryDy=0;entryPerimeter=0;exitX=0.6;exitY=0.896;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="j1Q4P6ECcRPmYqQHR8c3-70" source="j1Q4P6ECcRPmYqQHR8c3-82" target="j1Q4P6ECcRPmYqQHR8c3-80">
