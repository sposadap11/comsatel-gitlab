        </mxCell>
        <mxCell id="UZltXh6Wh5-jFhGSdRaW-76" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;fillColor=#f8cecc;strokeColor=#b85450;gradientColor=#ea6b66;" value="Modelar el dominio" vertex="1">
          <mxGeometry height="60" width="120" x="1306" y="1468" as="geometry" />
        </mxCell>
        <mxCell id="UZltXh6Wh5-jFhGSdRaW-77" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;fillColor=#f5f5f5;strokeColor=#666666;gradientColor=#b3b3b3;" value="Evolucionar" vertex="1">
          <mxGeometry height="60" width="120" x="1170" y="1468" as="geometry" />
        </mxCell>
        <mxCell id="UZltXh6Wh5-jFhGSdRaW-78" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;fillColor=#fff2cc;strokeColor=#d6b656;gradientColor=#ffd966;" value="Hablar siempre usando lenguaje &lt;b&gt;ubicuo&lt;/b&gt;" vertex="1">
          <mxGeometry height="60" width="169" x="1257" y="1258" as="geometry" />
        </mxCell>
        <mxCell id="UZltXh6Wh5-jFhGSdRaW-79" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;labelBackgroundColor=none;fontSize=12;align=center;size=0.04;spacingLeft=5;spacingRight=5;fillColor=#cdeb8b;strokeColor=#36393d;" value="...los equipos de desarrollo de productos tienen que enfocarse en el dominio core de negocio, esto es, las partes que son más importantes para el negocio y que necesitan más atención que las otras..." vertex="1">
          <mxGeometry height="90" width="250" x="916" y="1578" as="geometry" />
        </mxCell>
        <mxCell id="UZltXh6Wh5-jFhGSdRaW-80" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;labelBackgroundColor=none;fontSize=12;align=center;size=0.04;spacingLeft=5;spacingRight=5;fillColor=#fff2cc;strokeColor=#d6b656;gradientColor=#ffd966;" value="...El equipo de diseño puede establecer un profundo entendimiento, y conectar la jerga del dominio y las entidades en el software con un lenguaje obicuo &lt;b&gt;(común y riguroso)&lt;/b&gt; para manener el descubrimiento y evolución de los modelos del dominio..." vertex="1">
          <mxGeometry height="190" width="160" x="1436" y="1578" as="geometry" />
        </mxCell>
        <mxCell id="UZltXh6Wh5-jFhGSdRaW-81" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;labelBackgroundColor=none;fontSize=12;align=center;size=0.04;spacingLeft=5;spacingRight=5;fillColor=#f8cecc;strokeColor=#b85450;gradientColor=#ea6b66;" value="...como un conocimiento bien organizado y estructurado del problema en el espacio del dominio core junto con conceptos fundamentales, vocabulario, problemas y relaciones entre las entidades involucradas..." vertex="1">
          <mxGeometry height="90" width="250" x="916" y="1678" as="geometry" />
        </mxCell>
        <mxCell id="UZltXh6Wh5-jFhGSdRaW-82" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;labelBackgroundColor=none;fontSize=12;align=center;size=0.04;spacingLeft=5;spacingRight=5;fillColor=#f5f5f5;strokeColor=#666666;gradientColor=#b3b3b3;" value="...Los modelos de dominio necesitan evolucionar a través del tiempo vía un enfoque iterativo con retro-alimentación continua..." vertex="1">
          <mxGeometry height="90" width="250" x="1175" y="1678" as="geometry" />
        </mxCell>
        <mxCell id="UZltXh6Wh5-jFhGSdRaW-83" parent="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;labelBackgroundColor=none;fontSize=12;align=center;size=0.04;spacingLeft=5;spacingRight=5;fillColor=#dae8fc;strokeColor=#6c8ebf;gradientColor=#7ea6e0;" value="...los expertos en software suelen no conocer el dominio (negocio) y los analistas de negocio, suelen no conocer la implementación (tecnología y el software)..." vertex="1">
