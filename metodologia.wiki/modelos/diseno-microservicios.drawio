        <mxCell id="bUpdNS94yblyy_HTOMXc-42" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Aplicaciones Web con Angular&lt;/h1&gt;&lt;p&gt;En el siguiente diagrama se estructura la organización de los componentes para las aplicaciones Web basadas en Angular.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
